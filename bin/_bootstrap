#!/usr/bin/env bash
# Shared bootstrap for the Sourcery MCP launchers.
#
# Sourced by bin/run-server and bin/run-http. Resolves the plugin root from the
# sourcing script's location, keeps a Python venv + installed package inside the
# client-provided data directory (Agent Plugins: PLUGIN_DATA; Claude Code:
# CLAUDE_PLUGIN_DATA), and leaves the venv interpreter in VENV_PY.
#
# stdout is reserved for MCP protocol messages in stdio mode; every log line
# here goes to stderr.

_CALLER="${BASH_SOURCE[1]:-${BASH_SOURCE[0]}}"
BIN_DIR="$(cd "$(dirname "$_CALLER")" && pwd)"
PLUGIN_ROOT="$(dirname "$BIN_DIR")"

if [ ! -f "$PLUGIN_ROOT/pyproject.toml" ]; then
  echo "sourcery-agent: cannot find plugin root (looked at $PLUGIN_ROOT)" >&2
  exit 1
fi

# Agent Plugins clients set PLUGIN_DATA; Claude Code sets CLAUDE_PLUGIN_DATA.
DATA_DIR="${PLUGIN_DATA:-${CLAUDE_PLUGIN_DATA:-$HOME/.local/share/sourcery-agent}}"
VENV_DIR="$DATA_DIR/venv"
STAMP="$DATA_DIR/.install-stamp"

# Claude Code exports userConfig values as CLAUDE_PLUGIN_OPTION_<KEY>; use it as
# a fallback if SOURCERY_API_KEY was not expanded into the environment.
if [ -z "${SOURCERY_API_KEY:-}" ] || [[ "${SOURCERY_API_KEY}" == *'${'* ]]; then
  if [ -n "${CLAUDE_PLUGIN_OPTION_SOURCERY_API_KEY:-}" ]; then
    export SOURCERY_API_KEY="$CLAUDE_PLUGIN_OPTION_SOURCERY_API_KEY"
  fi
fi
# Host-agnostic key file: $DATA_DIR/sourcery_api_key. Useful when the host
# (OpenClaw, Devin, Hermes, …) does not expand ${user_config.*} references.
if [ -z "${SOURCERY_API_KEY:-}" ] || [[ "${SOURCERY_API_KEY}" == *'${'* ]]; then
  KEY_FILE="${SOURCERY_API_KEY_FILE:-$DATA_DIR/sourcery_api_key}"
  if [ -f "$KEY_FILE" ]; then
    SOURCERY_API_KEY="$(tr -d '[:space:]' < "$KEY_FILE")"
    export SOURCERY_API_KEY
  fi
fi
if [ -z "${SOURCERY_API_KEY:-}" ] || [[ "${SOURCERY_API_KEY}" == *'${'* ]]; then
  unset SOURCERY_API_KEY
  echo "sourcery-agent: SOURCERY_API_KEY is not set; Sourcery tool calls will fail until it is configured (environment, host config, or $DATA_DIR/sourcery_api_key)." >&2
fi

mkdir -p "$DATA_DIR"

needs_install() {
  if [ ! -x "$VENV_DIR/bin/python" ]; then
    return 0
  fi
  if [ ! -f "$STAMP" ]; then
    return 0
  fi
  # The stamp records which plugin root the editable install came from; a
  # moved/renamed plugin (even with preserved mtimes) must be reinstalled.
  if [ "$(head -n 1 "$STAMP" 2>/dev/null)" != "$PLUGIN_ROOT" ]; then
    return 0
  fi
  if [ -n "$(find "$PLUGIN_ROOT/pyproject.toml" "$PLUGIN_ROOT/src" -newer "$STAMP" -print -quit 2>/dev/null)" ]; then
    return 0
  fi
  return 1
}

if needs_install; then
  # Serialize concurrent launchers with a portable atomic mkdir lock
  # (flock(1) is not available on stock macOS).
  LOCK_DIR="$DATA_DIR/.bootstrap-lock"
  tries=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -ge 300 ]; then
      # ~60s of waiting: assume a stale lock from a crashed install and take it over.
      rm -rf "$LOCK_DIR" 2>/dev/null || true
    fi
    sleep 0.2 2>/dev/null || sleep 1
  done

  # Re-check after acquiring the lock: another launcher may have finished first.
  if needs_install; then
    if [ ! -x "$VENV_DIR/bin/python" ]; then
      echo "sourcery-agent: creating venv at $VENV_DIR" >&2
      python3 -m venv "$VENV_DIR" >&2
    fi
    echo "sourcery-agent: installing plugin package (first run or update)" >&2
    "$VENV_DIR/bin/pip" install --quiet --upgrade --disable-pip-version-check -e "$PLUGIN_ROOT" >&2
    printf '%s\n' "$PLUGIN_ROOT" > "$STAMP"
  fi
  rmdir "$LOCK_DIR" 2>/dev/null || rm -rf "$LOCK_DIR" 2>/dev/null || true
fi

VENV_PY="$VENV_DIR/bin/python"
export VENV_PY
